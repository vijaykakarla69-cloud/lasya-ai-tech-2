{
  "name": "start-app-dir-typescript",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export": "next export",
    "postbuild": "next-sitemap",
    "build_krivatech": "cross-env SITE_URL=https://kriva.tech npm run build && npm run postbuild",
    "build_lasyaaitech": "cross-env SITE_URL=https://lasyaaitech.com npm run build && npm run postbuild",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "start_lasyaaitech_dev": "cross-env PORT=3700 ENV=development PRINT_NETWORK_CALLS=true DEFAULT_COMPANY=lasyaaitech next dev",
    "start_lasyaaitech_prod_background": "cross-env PORT=3700 ENV=production PRINT_NETWORK_CALLS=true DEFAULT_COMPANY=lasyaaitech pm2 start npm --name 'lasyaaitech' -- start",
    "start_krivatech_dev": "cross-env PORT=3701 ENV=production PRINT_NETWORK_CALLS=true DEFAULT_COMPANY=krivatech next dev",
    "start_krivatech_prod_background": "cross-env PORT=3701 ENV=production PRINT_NETWORK_CALLS=true DEFAULT_COMPANY=krivatech pm2 start npm --name 'krivatech' -- start",
    "build_start": "npx serve@latest out"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@openpanel/nextjs": "^1.1.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.2.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/nextjs": "^9.19.0",
    "aos": "^2.3.4",
    "axios": "^1.7.9",
    "isotope-layout": "^3.0.6",
    "next": "^15.5.22",
    "next-sitemap": "^4.2.3",
    "react": "^18",
    "react-countup": "^6.5.3",
    "react-dom": "^18",
    "react-fast-marquee": "^1.6.5",
    "react-google-recaptcha": "^3.1.0",
    "react-markdown": "^9.0.1",
    "react-modal-video": "^2.0.2",
    "react-perfect-scrollbar": "^1.5.8",
    "react-toastify": "^10.0.6",
    "swiper": "^14.0.7",
    "wowjs": "^1.1.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/generator": "^7.26.5",
    "@babel/parser": "^7.26.7",
    "@babel/traverse": "^7.26.7",
    "@babel/types": "^7.26.7",
    "@svgr/webpack": "^8.1.0",
    "@types/aos": "^3.0.7",
    "@types/isotope-layout": "^3.0.14",
    "@types/node": "^20.17.16",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/react-modal-video": "^1.2.3",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^8",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.4.49",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5"
  }
}
