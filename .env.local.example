# Copy to .env.local: cp .env.local.example .env.local

# App (start_lasyaaitech_dev sets these via cross-env; optional in .env.local)
PORT=3700
ENV=development
DEFAULT_COMPANY=lasyaaitech

# Analytics — disable locally if you do not have credentials
NEXT_PUBLIC_OPENPANEL_ENABLED=false
# NEXT_PUBLIC_OPENPANEL_CLIENT_ID=your-openpanel-client-id

# Promo banners — optional; site runs without them
# BANNER_API_URL=https://your-banner-api.example/api/
# BANNER_CLIENT_ID=
# BANNER_CLIENT_SECRET=

# Search Console verification (per-brand — set the real value in each brand's
# deployment env, not here). Required now that the hardcoded <meta> tag in
# src/app/layout.tsx has been removed in favor of this env-driven one.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional
# PRINT_NETWORK_CALLS=true
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_API_BASE_URL=https://api.kriva.studio
