      {
        "id": 37,
        "documentId": "genai725xkz91pqm44bt29ml",
        "Details": [
          {
            "type": "heading",
            "level": 2,
            "children": [
              { "text": "POSITION OVERVIEW", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "text": "We're hiring a Gen AI Developer (0–2 years experience) eager to craft intelligent applications powered by cutting-edge generative technologies. You will design AI-driven tools and experiences that bridge creativity and computation, working closely with data scientists, engineers, and product designers.",
                "type": "text"
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "text": "You'll get hands-on experience developing large language model integrations, custom AI pipelines, and adaptive interfaces that empower users through intelligent automation and content generation.",
                "type": "text"
              }
            ]
          },
          {
            "type": "heading",
            "level": 3,
            "children": [
              { "text": "KEY RESPONSIBILITIES", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Build LLM-powered features, integrating APIs like OpenAI, Gemini, or Anthropic Claude into scalable web or app solutions.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Collaborate on fine-tuning, prompt design, and deployment of conversational or generative AI models.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Work with cloud and local processing pipelines to manage data securely for AI tasks.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Prototype and optimize user-facing AI interactions (chatbots, voice, and multimodal interfaces).", "type": "text" }
            ]
          },
          {
            "type": "heading",
            "level": 3,
            "children": [
              { "text": "SKILLS AND QUALIFICATIONS", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Bachelor's in Computer Science, Artificial Intelligence, or related technical field.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "0–2 years experience in AI/ML model integration or backend development.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Proficiency in Python, JavaScript/TypeScript, and REST or GraphQL API development.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Understanding of Hugging Face, LangChain, or other GenAI frameworks.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Ability to experiment, visualize results, and iterate rapidly in a research-driven setting.", "type": "text" }
            ]
          },
          {
            "type": "heading",
            "level": 3,
            "children": [
              { "text": "WE OFFER", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Mentorship from senior AI engineers and applied researchers.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Remote-first working environment and collaborative innovation culture.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Exposure to advanced AI infrastructure, tools, and frameworks.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Competitive pay and growth opportunities in R&D tracks.", "type": "text" }
            ]
          }
        ],
