      {
        "id": 36,
        "documentId": "fd83219xkq74nwg51cl0zqaa",
        "Details": [
          {
            "type": "heading",
            "level": 2,
            "children": [
              { "text": "POSITION OVERVIEW", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "text": "We are seeking a motivated Full Stack Developer with 0–2 years of hands-on experience in modern web development. You will work closely with cross-functional teams to build scalable, high-performance applications that deliver a seamless digital experience to users.",
                "type": "text"
              }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              {
                "text": "This role is ideal for a self-driven developer who thrives on both frontend and backend problem-solving, enjoys learning new technologies, and is passionate about delivering clean, maintainable code.",
                "type": "text"
              }
            ]
          },
          {
            "type": "heading",
            "level": 3,
            "children": [
              { "text": "YOUR BACKGROUND", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Bachelor's degree in Computer Science, Software Engineering, or a related discipline.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "0–2 years of experience in web or software development.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Proficiency with backend technologies like Node.js, Express, and REST APIs.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Hands-on experience in frontend frameworks such as Angular, React, or Vue.js.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Knowledge of databases — both SQL (PostgreSQL/MySQL) and NoSQL (MongoDB).", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Familiarity with version control systems (Git) and modern CI/CD pipelines.", "type": "text" }
            ]
          },
          {
            "type": "heading",
            "level": 3,
            "children": [
              { "text": "RESPONSIBILITIES", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Design, develop, and test web applications across the stack.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Collaborate with design teams to turn UI/UX wireframes into responsive applications.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Integrate APIs, manage database operations, and optimize application performance.", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Identify bugs and implement solutions using agile principles and version control.", "type": "text" }
            ]
          },
          {
            "type": "heading",
            "level": 3,
            "children": [
              { "text": "WE OFFER", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "25 annual leave days", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Competitive, performance-based compensation", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Exposure to full software lifecycle and professional growth mentorship", "type": "text" }
            ]
          },
          {
            "type": "paragraph",
            "children": [
              { "text": "Remote and flexible work environment", "type": "text" }
            ]
          }
        ],
